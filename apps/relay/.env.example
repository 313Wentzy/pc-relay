# Run npm run setup to generate signing keys into your local .env.
RELAY_OWNER_EMAIL=owner@example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REMOTE_RELAY_SECRET=
# Optional independent key for advanced website ticket integration.
REMOTE_PLATFORM_SECRET=
SUPABASE_PUBLISHABLE_KEY=
PORT=8790
HOST=127.0.0.1
RELAY_BROWSER_ORIGINS=
# WebRTC TURN fallback. Heroku/Cloudflare Tunnel do not relay WebRTC media.
# Include turns:YOUR_TURN_HOST:443?transport=tcp for Compatibility relay mode.
# Obtain authenticated TURN service credentials; these are not VPN credentials.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Cloudflare Realtime TURN alternative: server-only credential issuer.
# Keep both values off clients. Temporary ICE credentials are minted on Connect.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
PUBLIC_RELAY_ORIGIN=
# Optional temporary Cloudflare Tunnel mode. Set the public HTTPS origin above.
RELAY_REQUIRE_HTTPS=false
RELAY_ALLOW_LOOPBACK_HTTP=false
